{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.2.4",
        "firebase/php-jwt": "^6.3",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "guzzlehttp/psr7": "^1.5",
        "intervention/image": "^2.5",
        "kreait/firebase-php": "^5.24",
        "kreait/firebase-tokens": "^1.17",
        "kreait/laravel-firebase": "^2.0",
        "kwn/number-to-words": "^2.11",
        "laravel-notification-channels/fcm": "~2.0",
        "laravel/framework": "^8.0|^10.0|^11.0",
        "laravel/tinker": "^2.5",
        "milon/barcode": "^8.0",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^4.1",
        "phpoffice/phpword": "^1.3",
        "pusher/pusher-php-server": "^7.2",
        "ramsey/uuid": "^4.7",
        "vsd/dbx": "dev-main",
        "vsd/localization": "dev-main",
        "vsd/money": "*",
        "vsd/response": "dev-main",
        "vsd/script-manager": "dev-main",
        "vsd/storage": "*",
        "vsd/vsloquent": "dev-main",
        "vsd/xauth": "dev-main",
        "vsd/xquery": "dev-main"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Opt\\": "app/Http/Traits/chapx/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Vsd\\Response\\": "src/"
        },
       "files":[
           "app/helpers.php"
       ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/vectorasoft-org/lib-localization.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/vectorasoft-org/lib-response.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/vectorasoft-org/lib-storage.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/vectorasoft-org/lib-dbx.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/vectorasoft-org/lib-xauth.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/vectorasoft-org/lib-money.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/vectorasoft-org/lib-vsloquent.git",
            "require": {
                "vsd/vsloquent": "*"
            }
        },
         {
            "type": "vcs",
            "url": "https://github.com/vectorasoft-org/lib-script-manager.git"
        },
          {
            "type": "vcs",
            "url": "https://github.com/vectorasoft-org/lib-xquery.git"
        }
    ]
}
